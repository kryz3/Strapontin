# Copie ce fichier en .env (jamais versionné) puis remplis ce dont tu as besoin.
# scripts/bundle.sh le lit ligne à ligne (il n'est pas exécuté).

# Clé API TMDb (v3) fournie avec l'app : https://www.themoviedb.org/settings/api
# Vide = chacun saisit la sienne dans Réglages › Fiches.
TMDB_API_KEY=

# Clé API OpenSubtitles.com (sous-titres en ligne) : compte gratuit, puis https://www.opensubtitles.com/consumers
# Vide = chacun saisit la sienne dans Réglages › Lecture.
OPENSUBTITLES_API_KEY=

# Version et numéro de build (la CI les déduit du tag vX.Y.Z et du nombre de commits).
STRAPONTIN_VERSION=
STRAPONTIN_BUILD=

# Appcast Sparkle. Vide = déduit de GITHUB_REPOSITORY en CI ; vide en local = mises à jour intégrées éteintes.
STRAPONTIN_FEED_URL=

# Ton indexeur Torznab, pour ta copie personnelle seulement (ignoré en CI : une release publique n'en contient pas).
# Recopié dans les réglages au premier lancement ; ce qui est saisi dans Réglages › Indexeur garde la main.
# INDEXER_URL = adresse de base (https://…), INDEXER_API_PATH = chemin de l'API (ex. /api), INDEXER_API_KEY = clé API.
INDEXER_URL=
INDEXER_API_PATH=
INDEXER_API_KEY=
